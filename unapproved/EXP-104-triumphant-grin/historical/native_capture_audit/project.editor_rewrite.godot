; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Ryoko EXP104 Triumphant Grin PREVIEW ONLY"
run/main_scene="res://launcher.tscn"
config/features=PackedStringArray("4.6")

[display]

window/size/viewport_width=1136
window/size/viewport_height=800
window/size/window_width_override=1136
window/size/window_height_override=800

[editor]

movie_writer/fps=30
movie_writer/mjpeg_quality=0.85

[rendering]

renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.12, 0.13, 0.14, 1)
