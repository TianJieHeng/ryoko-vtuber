extends SceneTree
var count=0
func check(ok,message):
    count+=1
    if not ok:push_error(message);quit(1)
func _initialize():call_deferred("run")
func run():
    var d=load("res://look_at_driver.gd").new()
    d.aim(-1,-1)
    d.step(.1)
    check(d.eye.x<-.8,"eyes lead immediately")
    check(d.head==Vector3.ZERO,"head waits")
    d.step(.08)
    check(d.head.length()<.00001,"head has not anticipated delay")
    d.step(.02)
    check(d.head.y<0,"head begins after delay")
    for i in range(200):
        d.step(1.0/60)
        check(d.head.y>=-.55 and d.head.y<=0,"head bounded")
        check(d.eye.x>=-1 and d.eye.x<=0,"eye bounded")
    check(abs(d.head.y+.55)<.001,"head settles")
    check(abs(d.eye.x+.65)<.002,"eye compensates head")
    d.aim(1,1)
    var previous=d.head
    d.step(.1)
    check(d.eye.x>0,"eye retargets before head")
    check(d.head==previous,"head holds on large target switch")
    for i in range(240):d.step(1.0/60)
    check(d.head.y>.549,"head switches side")
    d.release()
    for i in range(500):
        d.step(1.0/60)
        check(d.head.y>=0,"release no overshoot")
    check(d.head==Vector3.ZERO and d.eye==Vector2.ZERO,"release exact rest")
    d.aim(INF,NAN);check(d.target==Vector2.ZERO,"finite input")
    d.aim(-5,5);check(d.target==Vector2(-1,1),"clamp input")
    d.reset();check(not d.active and d.head==Vector3.ZERO,"reset")
    var rig=load("res://motion_rig.tscn").instantiate()
    root.add_child(rig)
    await process_frame
    rig.set_process(false)
    rig.apply_controls({"reset":true,"body_follow":false})
    rig.apply_controls({"look_x":.9,"look_y":-.4})
    for i in range(180):
        rig._process(1.0/60)
        check(rig.body_target==Vector3.ZERO and rig.body_current==Vector3.ZERO,"look does not drive torso")
    check(rig.current.y>.49,"head integrated")
    check(rig.skin_material.get_shader_parameter("gaze_direction").x>.5,"gaze integrated")
    rig.apply_controls({"wink":"screen_left","mouth":"E"})
    rig._process(.1)
    check(rig.face.mouth_state=="E","mouth coexist")
    check(rig.skin_material.get_shader_parameter("gaze_open").x==0,"closed eye clipped")
    rig.apply_controls({"look_release":true})
    for i in range(600):rig._process(1.0/60)
    check(rig.current.length()<.0001,"head released")
    check(rig.skin_material.get_shader_parameter("gaze_direction")==Vector2.ZERO,"gaze released")
    var adapter=load("res://live_input.gd").new()
    var packet={"seq":1,"controls":{"look_x":.5,"look_y":-.5}}
    check(not adapter.decode(JSON.stringify(packet).to_utf8_buffer(),rig.expression_ids).is_empty(),"UDP accepts aim")
    packet.controls.look_x=2
    check(adapter.decode(JSON.stringify(packet).to_utf8_buffer(),rig.expression_ids).is_empty(),"UDP bounds")
    rig.apply_controls({"look_x":1,"reset":true})
    rig.apply_controls({"reset":true})
    check(not rig.attention.active,"reset clears attention")
    rig.apply_controls({"head_tilt":.3,"head_x":-.2,"body_follow":false,"body_tilt":.2})
    rig.apply_controls({"look_x":1,"look_y":-.5})
    for i in range(200):rig._process(1.0/60)
    rig.apply_controls({"look_release":true})
    for i in range(600):rig._process(1.0/60)
    check(abs(rig.current.x-.3)<.0001 and abs(rig.current.y+.2)<.0001,"release preserves base head pose")
    check(abs(rig.body_current.x-.2)<.0001,"base torso retained")
    check(adapter.start(19126)==OK,"actual UDP binding")
    var sender=PacketPeerUDP.new();sender.set_dest_address("127.0.0.1",19126)
    sender.put_packet('{"seq":1,"controls":{"look_x":-0.7,"look_y":0.2}}'.to_utf8_buffer())
    await create_timer(.04).timeout
    adapter.poll(.01,rig)
    check(adapter.accepted==1 and rig.attention.active and rig.attention.target.x<-.69,"actual UDP aim")
    adapter.poll(2.1,rig)
    check(not rig.attention.active and rig.attention.head==Vector3.ZERO,"UDP timeout resets look")
    adapter.stop();sender.close()
    rig.queue_free();await process_frame
    print("LOOK_AT_CHECKS_PASS count=",count)
    quit()
